# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TIMEZONE=Asia/Jakarta

# Database Configuration (SQLite Local File)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173"

# Seat Hold Expiration Duration in Minutes (Default 10 minutes)
SEAT_HOLD_DURATION_MINUTES=10

# Webhook Secret for Payment Gateway Simulation
PAYMENT_WEBHOOK_SECRET="replace-with-payment-provider-webhook-secret"
ALLOW_PAYMENT_SIMULATION=true

# Rate Limiter Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

{
  "name": "kelana-shuttle-admin-be",
  "version": "1.0.0",
  "description": "Backend REST API and Admin Operations for Kelana Nova",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} vitest run",
    "test:watch": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} vitest",
    "test:coverage": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} vitest run --coverage",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "prisma:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push",
    "prisma:migrate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push && DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate && DATABASE_URL=${DATABASE_URL:-file:./dev.db} tsx prisma/seed.ts"
  },
  "keywords": [
    "kelana-shuttle",
    "backend",
    "express",
    "typescript",
    "prisma",
    "rest-api"
  ],
  "author": "Kelana Nova Engineering",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/yamljs": "^0.2.34",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
